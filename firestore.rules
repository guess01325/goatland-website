rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(playerId) {
      return request.auth != null && request.auth.uid == playerId;
    }

    function hasValidPlayerData() {
      return request.resource.data.keys().hasOnly([
        'displayName',
        'email',
        'dateOfBirth',
        'state',
        'accountStatus',
        'profileComplete',
        'rulesVersionAccepted',
        'rulesAcceptedAt',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.displayName is string
      && request.resource.data.displayName.size() >= 2
      && request.resource.data.displayName.size() <= 40
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.dateOfBirth is string
      && request.resource.data.state is string
      && request.resource.data.accountStatus == 'active'
      && request.resource.data.profileComplete == true
      && request.resource.data.rulesVersionAccepted is string
      && request.resource.data.rulesAcceptedAt is timestamp
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }

    function preservesSystemFields() {
      return request.resource.data.email == resource.data.email
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.profileComplete == resource.data.profileComplete
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /players/{playerId} {
      allow create: if isOwner(playerId)
        && hasValidPlayerData()
        && request.resource.data.rulesAcceptedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get: if isOwner(playerId);
      allow list, delete: if false;
      allow update: if isOwner(playerId)
        && hasValidPlayerData()
        && preservesSystemFields()
        && request.resource.data.updatedAt == request.time;
    }

    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /tiers/{tierId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /leagueStarts/{leagueStartId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /registrationOfferings/{offeringId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /leagues/{leagueId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /publicRoster/{rosterEntryId} {
        allow read: if request.auth != null;
        allow create, update, delete: if false;
      }
    }

    match /promoters/{promoterId} {
      allow read, create, update, delete: if false;
    }

    match /promoCodes/{promoCodeId} {
      allow read, create, update, delete: if false;
    }

    function hasValidRegistrationData() {
      return request.resource.data.keys().hasOnly([
        'playerId',
        'registrationOfferingId',
        'leagueId',
        'status',
        'competitionRulesVersionAccepted',
        'competitionRulesAcceptedAt',
        'refundPolicyVersionAccepted',
        'refundPolicyAcceptedAt',
        'acquisitionSource',
        'acquisitionSourceOther',
        'promoCodeId',
        'promoCodeSnapshot',
        'promoterIdSnapshot',
        'registrationOrder',
        'createdAt',
        'updatedAt',
        'submittedAt',
        'confirmedAt',
        'cancelledAt'
      ])
      && request.resource.data.playerId is string
      && request.resource.data.registrationOfferingId is string
      && request.resource.data.leagueId is string
      && request.resource.data.leagueId.size() > 0
      && request.resource.data.competitionRulesVersionAccepted is string
      && request.resource.data.competitionRulesVersionAccepted.size() > 0
      && request.resource.data.refundPolicyVersionAccepted is string
      && request.resource.data.refundPolicyVersionAccepted.size() > 0
      && request.resource.data.acquisitionSource in [
        'facebook',
        'instagram',
        'tiktok',
        'discord',
        'google',
        'friend_family',
        'event',
        'other'
      ]
      && ((request.resource.data.acquisitionSource != 'other'
          && request.resource.data.acquisitionSourceOther == null)
        || (request.resource.data.acquisitionSource == 'other'
          && request.resource.data.acquisitionSourceOther is string
          && request.resource.data.acquisitionSourceOther.size() >= 1
          && request.resource.data.acquisitionSourceOther.size() <= 100
          && !request.resource.data.acquisitionSourceOther.matches('^\\s.*')
          && !request.resource.data.acquisitionSourceOther.matches('.*\\s$')))
      && ((request.resource.data.promoCodeId == null
          && request.resource.data.promoCodeSnapshot == null
          && request.resource.data.promoterIdSnapshot == null)
        || (request.resource.data.promoCodeId is string
          && request.resource.data.promoCodeId.size() > 0
          && request.resource.data.promoCodeSnapshot is string
          && request.resource.data.promoCodeSnapshot.size() > 0
          && request.resource.data.promoterIdSnapshot is string
          && request.resource.data.promoterIdSnapshot.size() > 0))
      && request.resource.data.competitionRulesAcceptedAt is timestamp
      && request.resource.data.refundPolicyAcceptedAt is timestamp
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp
      && request.resource.data.submittedAt is timestamp
      && (request.resource.data.confirmedAt == null
        || request.resource.data.confirmedAt is timestamp)
      && (request.resource.data.cancelledAt == null
        || request.resource.data.cancelledAt is timestamp)
      && (request.resource.data.registrationOrder == null
        || request.resource.data.registrationOrder is int);
    }

    function hasValidExistingAcquisitionData() {
      return resource.data.keys().hasAll([
        'acquisitionSource',
        'acquisitionSourceOther'
      ])
      && resource.data.acquisitionSource in [
        'facebook',
        'instagram',
        'tiktok',
        'discord',
        'google',
        'friend_family',
        'event',
        'other'
      ]
      && ((resource.data.acquisitionSource != 'other'
          && resource.data.acquisitionSourceOther == null)
        || (resource.data.acquisitionSource == 'other'
          && resource.data.acquisitionSourceOther is string
          && resource.data.acquisitionSourceOther.size() >= 1
          && resource.data.acquisitionSourceOther.size() <= 100
          && !resource.data.acquisitionSourceOther.matches('^\\s.*')
          && !resource.data.acquisitionSourceOther.matches('.*\\s$')));
    }

    function isOpenOffering(offeringId) {
      let offering = get(/databases/$(database)/documents/registrationOfferings/$(offeringId));
      return exists(/databases/$(database)/documents/registrationOfferings/$(offeringId))
        && offering.data.status == 'enabled'
        && offering.data.registrationOpensAt is timestamp
        && offering.data.registrationClosesAt is timestamp
        && offering.data.registrationOpensAt <= request.time
        && offering.data.registrationClosesAt >= request.time;
    }

    function isOpenLeagueForOffering(leagueId, offeringId) {
      let league = get(/databases/$(database)/documents/leagues/$(leagueId));
      return exists(/databases/$(database)/documents/leagues/$(leagueId))
        && league.data.registrationOfferingId == offeringId
        && league.data.status == 'open';
    }

    match /registrations/{registrationId} {
      allow get: if request.auth != null
        && resource.data.playerId == request.auth.uid;
      allow list: if false;
      allow create: if request.auth != null
        && hasValidRegistrationData()
        && request.resource.data.playerId == request.auth.uid
        && !request.resource.data.playerId.matches('.*[|].*')
        && !request.resource.data.registrationOfferingId.matches('.*[|].*')
        && registrationId == request.resource.data.playerId + '|'
          + request.resource.data.registrationOfferingId
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && isOpenOffering(request.resource.data.registrationOfferingId)
        && isOpenLeagueForOffering(
          request.resource.data.leagueId,
          request.resource.data.registrationOfferingId
        )
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.promoCodeId == null
        && request.resource.data.promoCodeSnapshot == null
        && request.resource.data.promoterIdSnapshot == null
        && request.resource.data.registrationOrder == null
        && request.resource.data.confirmedAt == null
        && request.resource.data.cancelledAt == null
        && request.resource.data.competitionRulesAcceptedAt == request.time
        && request.resource.data.refundPolicyAcceptedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.submittedAt == request.time;
      allow update: if request.auth != null
        && resource.data.playerId == request.auth.uid
        && !exists(
          /databases/$(database)/documents/registrationCheckoutLocks/$(registrationId)
        )
        && resource.data.status == 'pending_payment'
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'cancelledAt',
            'updatedAt'
          ])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.updatedAt == request.time)
        || (hasValidExistingAcquisitionData()
          && hasValidRegistrationData()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'acquisitionSource',
            'acquisitionSourceOther',
            'updatedAt'
          ])
          && request.resource.data.status == 'pending_payment'
          && request.resource.data.updatedAt == request.time)
        || (hasValidRegistrationData()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'leagueId',
            'updatedAt'
          ])
          && request.resource.data.status == 'pending_payment'
          && request.resource.data.updatedAt == request.time
          && isOpenLeagueForOffering(
            request.resource.data.leagueId,
            resource.data.registrationOfferingId
          )));
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read, create, update, delete: if false;
    }

    match /registrationCheckoutLocks/{registrationId} {
      allow read, create, update, delete: if false;
    }

    match /reconciliationScanCursors/{status} {
      allow read, create, update, delete: if false;
    }

    match /seatHolds/{seatHoldId} {
      allow read, create, update, delete: if false;
    }

    match /stripeWebhookEvents/{eventId} {
      allow read, create, update, delete: if false;
    }
  }
}
